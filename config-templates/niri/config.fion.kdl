// niri config for fion (GPD Pocket 4). Shared settings live in common.kdl;
// only machine-specific bits go here. Find output names with `niri msg outputs`.
include "common.kdl"

// The GPD Pocket 4 panel is natively portrait (1600x2560), so rotate it to landscape.
output "eDP-1" {
    transform "270"
    // scale 1.25
}

// Small screen: open new windows at two-thirds width (matches the Mod+R preset).
layout {
    default-column-width { proportion 0.66667; }
}

// The Pocket 4 keyboard can't reliably register Mod+<modifier>+arrow, so
// disable every Mod+arrow bind from common.kdl to build the Mod+hjkl habit.
// Niri has no no-op action; spawning `true` is the closest thing.
binds {
    Mod+Left             { spawn "true"; }
    Mod+Down             { spawn "true"; }
    Mod+Up               { spawn "true"; }
    Mod+Right            { spawn "true"; }
    Mod+Shift+Left       { spawn "true"; }
    Mod+Shift+Down       { spawn "true"; }
    Mod+Shift+Up         { spawn "true"; }
    Mod+Shift+Right      { spawn "true"; }
    Mod+Ctrl+Left        { spawn "true"; }
    Mod+Ctrl+Down        { spawn "true"; }
    Mod+Ctrl+Up          { spawn "true"; }
    Mod+Ctrl+Right       { spawn "true"; }
    Mod+Ctrl+Shift+Left  { spawn "true"; }
    Mod+Ctrl+Shift+Down  { spawn "true"; }
    Mod+Ctrl+Shift+Up    { spawn "true"; }
    Mod+Ctrl+Shift+Right { spawn "true"; }
}

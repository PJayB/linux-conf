// niri config for fion (GPD Pocket 4). Shared settings live in common.kdl;
// only machine-specific bits go here. Find output names with `niri msg outputs`.
include "common.kdl"

// The GPD Pocket 4 panel is natively portrait (1600x2560), so rotate it to landscape.
output "eDP-1" {
    transform "270"
    // scale 1.25
}

// Small screen: open new windows at two-thirds width (matches the Mod+R preset).
layout {
    default-column-width { proportion 0.66667; }
}
